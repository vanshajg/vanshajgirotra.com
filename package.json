    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "image-size": "2.0.2",
    "mdx-bundler": "10.1.1",
    "next": "16.2.12",
    "next-themes": "0.4.6",
    "postcss": "8.5.23",
    "preact": "10.29.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
